#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @MAJOR@,@MINOR@,@MICRO@,@NANO@
PRODUCTVERSION @MAJOR@,@MINOR@,@MICRO@,@NANO@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Frida"
      VALUE "FileDescription", "Frida Gadget"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "frida-gadget"
      VALUE "OriginalFilename", "frida-gadget.dll"
      VALUE "ProductName", "Frida"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
