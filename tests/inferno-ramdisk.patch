diff --git a/hw/char/apple_uart.c b/hw/char/apple_uart.c
index 55a7d1b..ffe45de 100644
--- a/hw/char/apple_uart.c
+++ b/hw/char/apple_uart.c
@@ -397,7 +397,7 @@ static void apple_uart_write(void* opaque, hwaddr offset, uint64_t val, unsigned
             break;
 
         case UTRSTAT:
-            val                 &= (UTRSTAT_Tx_EMPTY);
+            val                 &= (UTRSTAT_Tx_EMPTY | UTRSTAT_Tx_THRESH);
             s->reg[I_(UTRSTAT)] &= ~val;
             trace_apple_uart_intclr(s->channel, s->reg[I_(UTRSTAT)]);
             apple_uart_update_irq(s);
@@ -409,7 +409,10 @@ static void apple_uart_write(void* opaque, hwaddr offset, uint64_t val, unsigned
         case UFSTAT:
         case UMSTAT:
         case URXH  : trace_apple_uart_ro_write(s->channel, apple_uart_regname(offset), offset); break;
-        case UCON  : apple_uart_update_irq(s); break;
+        case UCON  :
+            s->reg[I_(UCON)] = val;
+            apple_uart_update_irq(s);
+            break;
         case UMCON :
         default    : s->reg[I_(offset)] = val; break;
     }
