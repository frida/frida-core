 PROP_GETTER_SETTER(bool, force_dfu);
+PROP_BOOT_STR_GETTER_SETTER(trustcache_filename);
 PROP_BOOT_STR_GETTER_SETTER(seprom_filename);
 PROP_BOOT_STR_GETTER_SETTER(securerom_filename);
